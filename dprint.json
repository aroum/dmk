{
  "markdown": {
  },
  "json": {
  },
  "toml": {
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "/opt/homebrew/opt/llvm/bin/clang-format {{file_path}}",
        "exts": ["c", "h", "cpp"]
      }
    ]
  },
  "includes": [
    "dmk_core/**/*.{c,h,md,json,toml}",
    "platforms/**/*.{c,h,cpp,md,json,toml}",
    "keyboards/**/*.{c,h,md,json,toml}",
    "docs/**/*.md",
    "*.{md,json,toml}"
  ],
  "excludes": [
    "examples/**",
    "tools/vial/cJSON/**",
    "**/dep/**",
    "**/freertos/**",
    "**/Drivers/**",
    "**/Middlewares/**",
    "**/sdk/**",
    "**/Components/**",
    "**/build/**",
    "**/*_generated.h"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/exec-0.7.3.json"
  ]
}
