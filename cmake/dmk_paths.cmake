# Escape directory names before appending intentional file(GLOB) wildcards.
function(dmk_literal_glob_path output path)
    set(_escaped "")
    string(LENGTH "${path}" _length)
    if(_length GREATER 0)
        math(EXPR _last "${_length} - 1")
        foreach(_i RANGE 0 ${_last})
            string(SUBSTRING "${path}" ${_i} 1 _char)
            if(_char STREQUAL "[" OR _char STREQUAL "]" OR _char STREQUAL "*" OR _char STREQUAL "?")
                string(APPEND _escaped "[${_char}]")
            else()
                string(APPEND _escaped "${_char}")
            endif()
        endforeach()
    endif()
    set(${output} "${_escaped}" PARENT_SCOPE)
endfunction()
