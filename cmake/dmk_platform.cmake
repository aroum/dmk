# Loaded before project(): a platform can select toolchain, SDK and RTOS port.
set(DMK_PLATFORM_DIR "" CACHE PATH "External platform package directory")
set(_dmk_platform "${DMK_PLATFORM_DIR}")
if(NOT _dmk_platform AND EXISTS "${ACTUAL_KBD_DIR}/config.h")
    file(STRINGS "${ACTUAL_KBD_DIR}/config.h" _dmk_platform_lines
        REGEX "^[ \t]*#[ \t]*define[ \t]+DMK_PLATFORM_DIR[ \t]+\"")
    foreach(_line IN LISTS _dmk_platform_lines)
        if(_line MATCHES "^[ \t]*#[ \t]*define[ \t]+DMK_PLATFORM_DIR[ \t]+\"([^\"]+)\"")
            set(_dmk_platform "${CMAKE_MATCH_1}")
            break()
        endif()
    endforeach()
endif()
if(_dmk_platform)
    get_filename_component(_dmk_platform "${_dmk_platform}" ABSOLUTE BASE_DIR "${ACTUAL_KBD_DIR}")
else()
    # A checked-out config repository can carry its platform next to keyboards/.
    execute_process(COMMAND git -C "${ACTUAL_KBD_DIR}" rev-parse --show-toplevel
        OUTPUT_VARIABLE _dmk_config_root OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    set(_dmk_candidates "${ACTUAL_KBD_DIR}/platforms/${MCU}" "${ACTUAL_KBD_DIR}/platform")
    if(_dmk_config_root AND NOT _dmk_config_root STREQUAL DMK_ROOT)
        list(APPEND _dmk_candidates "${_dmk_config_root}/platforms/${MCU}")
    endif()
    foreach(_candidate IN LISTS _dmk_candidates)
        if(EXISTS "${_candidate}/platform.cmake")
            set(_dmk_platform "${_candidate}")
            break()
        endif()
    endforeach()
endif()
if(_dmk_platform)
    if(NOT EXISTS "${_dmk_platform}/platform.cmake")
        message(FATAL_ERROR "External platform requires platform.cmake: ${_dmk_platform}")
    endif()
    set(PLATFORM_DIR "${_dmk_platform}")
    set(DMK_EXTERNAL_PLATFORM ON)
elseif(MCU STREQUAL "rp2040" OR MCU STREQUAL "rp2350")
    set(PLATFORM_DIR "${DMK_ROOT}/platforms/raspberrypi")
else()
    set(PLATFORM_DIR "${DMK_ROOT}/platforms/${MCU}")
endif()
if(NOT EXISTS "${PLATFORM_DIR}/platform.cmake")
    message(FATAL_ERROR "Platform ${MCU} not found; provide DMK_PLATFORM_DIR with platform.cmake")
endif()

# Replace selected portable-driver implementations, preserving software features.
# Both core and PLATFORM_SRC lists pass through this helper.
function(dmk_platform_resolve_sources output)
    set(_result "")
    foreach(_source IN LISTS ARGN)
        string(FIND "${_source}" "${DMK_ROOT}/dmk_core/drivers/" _driver_prefix)
        if(_driver_prefix EQUAL 0)
            get_filename_component(_name "${_source}" NAME)
            if(_name IN_LIST DMK_PLATFORM_EXCLUDE_DRIVERS)
                continue()
            endif()
            if(DMK_PLATFORM_DRIVER_DIR AND EXISTS "${DMK_PLATFORM_DRIVER_DIR}/${_name}")
                set(_source "${DMK_PLATFORM_DRIVER_DIR}/${_name}")
            endif()
        endif()
        list(APPEND _result "${_source}")
    endforeach()
    list(REMOVE_DUPLICATES _result)
    set(${output} "${_result}" PARENT_SCOPE)
endfunction()
